{
  "builds": [
    { "src": "alphafinder_dashboard.html", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/alphafinder_dashboard.html"
    },
    {
      "src": "/alphafinder_dashboard.html",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/alphafinder_dashboard.html"
    }
  ]
}
